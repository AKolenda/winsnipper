#!/usr/bin/env bash
# Per-user half of the .deb install: GSettings are per user, so apt cannot do this.
set -euo pipefail

UUID='winsnipper@winsnipper.local'
HELPER=/usr/share/winsnipper/tools/keybindings.py
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/winsnipper"
BACKUP="$DATA_DIR/keybinding-backup.json"
# Written by the first setup/remove; stops the login autostart from undoing a choice.
MARKER="$DATA_DIR/setup-done"

usage() {
    printf '%s\n' "Usage: winsnipper-setup [--remove | --first-run]" \
        '  (no option)  take over Super+Shift+S and enable the WinSnipper extension' \
        '  --remove     restore the original Super+Shift+S bindings and disable WinSnipper' \
        '  --first-run  like no option, but only if setup has never run for this user'
}

enable() {
    mkdir -p "$DATA_DIR"
    python3 "$HELPER" --backup "$BACKUP" disable
    python3 "$HELPER" enable-extension
    gnome-extensions enable "$UUID" 2>/dev/null || true
    touch "$MARKER"
}

case "${1:-}" in
    '')
        enable
        printf '%s\n' 'WinSnipper enabled. If Super+Shift+S does nothing yet, log out and back in once.' ;;
    --first-run)
        [[ -e "$MARKER" ]] || enable ;;
    --remove)
        gnome-extensions disable "$UUID" 2>/dev/null || true
        python3 "$HELPER" disable-extension
        python3 "$HELPER" --backup "$BACKUP" restore
        mkdir -p "$DATA_DIR"
        touch "$MARKER"
        printf '%s\n' 'WinSnipper disabled; original Super+Shift+S bindings restored.' ;;
    -h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
